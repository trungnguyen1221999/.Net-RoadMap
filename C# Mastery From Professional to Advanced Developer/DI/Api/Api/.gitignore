# .gitignore for .NET projects

# Build results
bin/
obj/
out/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Visual Studio
.vs/

# NuGet packages
*.nupkg
packages/
*.snupkg

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Others
*.swp
*.tmp
*.bak
*.cache

# Rider
.idea/
*.sln.iml
