# .gitignore for common programming environments
# Ignore node_modules
node_modules/

# Ignore Python cache
__pycache__/
*.pyc

# Ignore macOS files
.DS_Store

# Ignore Visual Studio files
*.user
*.suo
*.userosscache
*.sln.docstates

# Ignore Visual Studio and VS Code environment folders and index files
.vs/
*.vsidx

# Ignore build output
bin/
obj/

# Ignore logs
*.log

# Ignore SQLite database files
*.sqlite
*.sqlite3
*.db
*.db3

# Ignore backup files
*.bak
*.backup
*.tmp

# Ignore JSON backup files
*.json.bak
*.json.backup

# Ignore environment files
.env

# Ignore IDE folders
.vscode/
.idea/
